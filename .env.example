# Optional: switch storage from the default SQLite file (./data/claritydocs.db)
# to PostgreSQL. Only takes effect together with `docker compose --profile
# postgres up -d` (see docker-compose.yml). Leave blank to use SQLite.
# DATABASE_URL=postgresql://claritydocs:changeme@postgres:5432/claritydocs

# Optional: single sign-on via any standard OIDC provider (Authentik,
# Keycloak, Authelia, Zitadel, ...). Leave all three blank to disable --
# the password login form is always available regardless.
# OIDC_ISSUER_URL=https://auth.example.com/application/o/claritydocs/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=authentik
